{
  "name": "@lumen/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "SDK del motor LUMEN: tipos y clientes generados desde proto/ (ADR-0012) + mocks.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^4"
  }
}
