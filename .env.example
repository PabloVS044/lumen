# ---------- web (apps/web) ----------
# URL interna del motor; el BFF /api/engine/* hace proxy aquí
ENGINE_URL=http://localhost:8000
# Límite de métodos caros (Analyze, Compare, FindBestSpot, CreateExport) por IP y minuto en el BFF
RATE_LIMIT_PER_MIN=30
NEXT_PUBLIC_CESIUM_ION_TOKEN=
# ID del asset "Cesium Moon" en Cesium ion (Asset Depot). ⚠️ VERIFICAR; sin él el globo usa una esfera simple
NEXT_PUBLIC_CESIUM_MOON_ASSET_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 1 = usar los mocks del SDK (@lumen/sdk/mocks) en vez del motor
NEXT_PUBLIC_ENGINE_MOCK=0

# ---------- engine (services/engine) ----------
DATABASE_URL=postgresql://lumen:lumen@localhost:5432/lumen
REDIS_URL=redis://localhost:6379/0
# Rutas: por defecto se resuelven desde la raíz del repo (core/config.py). Solo definir para sobrescribir.
# DEM_BASE_URL=
# DEM_INDEX_URL=
# KERNELS_DIR=
# CATALOG_PATH=
MAX_RANGE_DAYS=730
CORS_ORIGINS=["http://localhost:3000"]
# Object storage (R2/S3) — solo prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
